{
  "name": "@danielmadsendk/nowdev-ai-toolbox-documentationsearch",
  "version": "0.2.0",
  "description": "DocumentationSearch: local-first ServiceNow documentation indexing and semantic search",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Aagren Seehartrai Madsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielMadsenDK/NowDev-AI-Toolbox-Documentation-Search.git"
  },
  "homepage": "https://github.com/DanielMadsenDK/NowDev-AI-Toolbox-Documentation-Search#readme",
  "bugs": {
    "url": "https://github.com/DanielMadsenDK/NowDev-AI-Toolbox-Documentation-Search/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "servicenow",
    "mcp",
    "semantic-search",
    "documentation",
    "sqlite"
  ],
  "engines": {
    "node": "^22.13 || ^24 || >=26"
  },
  "bin": {
    "nowdev-ai-toolbox-documentationsearch": "./dist/cli-entry.js",
    "nowdev-ai-toolbox-documentationsearch-mcp": "./dist/mcp-entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "eval:retrieval": "npm run build && node scripts/eval-retrieval.ts",
    "bench:indexing": "npm run build && node scripts/bench-indexing.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  }
}
